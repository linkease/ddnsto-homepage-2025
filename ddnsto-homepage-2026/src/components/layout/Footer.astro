---
import { footerGroups } from '@/content/footer';
import { support } from '@/content/commerce';
---

{
  Astro.url.pathname !== '/' && (
    <div class="footer-assistant refresh-surface">
      <a href={support.ai} target="_blank" rel="noopener noreferrer">
        更多疑问？问问 AI助手？
      </a>
    </div>
  )
}
<footer class="site-footer refresh-surface" id="contact">
  <div class="refresh-container">
    <div class="footer-grid">
      <div class="footer-brand">
        <a href="#main" class="footer-wordmark">DDNSTO</a><p>
          从任何地方访问您的家庭设备的最简单方法。安全、快速、可靠。
        </p>
      </div><div class="footer-groups">
        {
          footerGroups.map((group) => (
            <div class="footer-group">
              <h3>{group.title}</h3>
              {group.links.map((link) => (
                <a
                  href={link.url}
                  target={link.url.startsWith('mailto:') ? undefined : '_blank'}
                  rel="noopener"
                >
                  {link.label}
                </a>
              ))}
            </div>
          ))
        }
      </div>
    </div>
    <div class="footer-legal">
      <p>Copyright © 2019-2026 {support.company} 版权所有</p><div
        class="footer-records"
      >
        <a
          href="https://beian.miit.gov.cn/#/Integrated/index"
          target="_blank"
          rel="noopener">备案号： 粤ICP备20024441号</a
        ><a
          href="https://assets.koolcenter.com/linkease/VTBOL.pdf"
          target="_blank"
          rel="noopener">增值电信业务经营许可 粤B2-20251165</a
        ><a
          href="https://www.beian.gov.cn/portal/registerSystemInfo?recordcode=44030002008017"
          target="_blank"
          rel="noopener"
          class="police-record"
          ><svg viewBox="0 0 24 24" aria-hidden="true"
            ><path d="M12 22s8-4 8-11V5l-8-3-8 3v6c0 7 8 11 8 11Z"></path><path
              d="m9 12 2 2 4-4"></path></svg
          >粤公网安备44030002008017号</a
        >
      </div><p>
        公司地址：{support.address}
        <a href={`tel:${support.phone}`}>联系电话：{support.phone}</a>
      </p>
    </div>
  </div>
</footer>
<style>
  .footer-assistant {
    padding: 40px 20px;
    text-align: center;
    background: #0a0a0f;
  }
  .footer-assistant a {
    color: #00f0ff;
    text-decoration: none;
    font-weight: 500;
  }
  .site-footer {
    background: #0a0a0f;
    border-top: 1px solid #ffffff0d;
    padding: 64px 0 32px;
    color: #9ca3af;
  }
  .footer-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 48px;
    margin-bottom: 48px;
  }
  .footer-groups {
    grid-column: span 3;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 24px;
  }
  .site-footer a {
    color: #d1d5db;
    text-decoration: none;
  }
  .site-footer a:hover {
    color: #00f0ff;
  }
  .site-footer .footer-wordmark {
    display: block;
    font-size: 24px;
    line-height: 32px;
    font-weight: 700;
    color: #fff;
  }
  .footer-brand p {
    font-size: 14px;
    line-height: 22.75px;
    margin: 16px 0 0;
  }
  .footer-group h3 {
    font-size: 16px;
    line-height: 24px;
    font-weight: 700;
    color: #fff;
    margin: 0 0 12px;
  }
  .footer-group a {
    display: block;
    font-size: 14px;
    line-height: 20px;
    margin: 0 0 8px;
  }
  .footer-group a:last-child {
    margin-bottom: 0;
  }
  .police-record {
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }
  .police-record svg {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .footer-legal {
    border-top: 1px solid #ffffff0d;
    padding-top: 32px;
    font-size: 14px;
    line-height: 20px;
  }
  .footer-legal p {
    margin: 0;
  }
  .footer-records {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px;
    margin: 12px 0;
  }
  .footer-legal p a {
    color: #9ca3af;
  }
  @media (max-width: 1023px) {
    .footer-groups {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (max-width: 767px) {
    .footer-groups {
      grid-column: auto;
    }
    .footer-grid {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 639px) {
    .footer-groups {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
