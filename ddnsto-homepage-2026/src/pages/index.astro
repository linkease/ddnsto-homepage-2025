---
import SiteLayout from '@/layouts/SiteLayout.astro';
import Header from '@/components/layout/Header.astro';
import Features from '@/features/features/Features.astro';
import Hero from '@/features/hero/Hero.astro';
import Scenarios from '@/features/scenarios/Scenarios.astro';
import Installation from '@/features/installation/Installation.astro';
import Pricing from '@/features/pricing/Pricing.astro';
import Faq from '@/features/faq/Faq.astro';
import Footer from '@/components/layout/Footer.astro';
import Support from '@/features/support/Support.astro';
---

<SiteLayout title="DDNSTO · 远程访问，如此简单">
  <Header />
  <main id="main">
    <Hero /><Features /><Scenarios /><Installation /><Pricing /><Faq />
  </main>
  <Footer /><Support />
</SiteLayout>

<script>
  import { setupScrollReveal } from '@/lib/scrollReveal';
  setupScrollReveal();
</script>
