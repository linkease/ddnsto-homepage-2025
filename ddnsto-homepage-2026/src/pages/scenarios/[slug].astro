---
import GuideLayout from '@/layouts/GuideLayout.astro';
import { scenarioGuides } from '@/content/scenarioGuides';
export function getStaticPaths() {
  return scenarioGuides.map((guide) => ({
    params: { slug: guide.id },
    props: { guide },
  }));
}
const { guide } = Astro.props;
---

<GuideLayout title={guide.title} description={guide.summary}>
  <h2>开始前需要准备什么</h2><ul>
    {guide.requirements.map((text) => <li>{text}</li>)}
  </ul>
  <h2>使用流程</h2><ol>{guide.steps.map((text) => <li>{text}</li>)}</ol>
  <h2>能力与使用边界</h2><p class="note">{guide.limits}</p>
  <div class="guide-actions">
    <a href={`/#${guide.id}-scenario`}>体验交互演示</a><a href="/#devices"
      >选择设备并安装</a
    ><a href="/#pricing">查看套餐权益</a><a
      href={guide.source}
      target="_blank"
      rel="noopener">查看官方说明</a
    >
  </div>
  <h2>其他使用场景</h2><ul>
    {
      scenarioGuides
        .filter((x) => x.id !== guide.id)
        .map((x) => (
          <li>
            <a href={`/scenarios/${x.id}/`}>{x.title}</a>
          </li>
        ))
    }
  </ul>
</GuideLayout>
