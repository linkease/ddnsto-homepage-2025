  {
    "label": "群晖",
    "url": "https://doc.istoreos.com/zh/guide/ddnsto/quickstart/install-guide/synology.html",
    "note": "",
    "steps": [
      {
        "title": "下载安装包",
        "text": "按 CPU 架构和 DSM 版本选择安装包；DSM 7.x 升级前先卸载旧版。",
        "kind": "design",
        "links": [],
        "illustrationHtml": "<div class=\"si-window\" role=\"group\" aria-label=\"群晖：下载安装包，界面示意\"><div class=\"si-window-bar\"><span class=\"si-dots\">● ● ●</span><span>群晖</span><small>界面示意</small></div><div class=\"si-window-content si-spk-content\"><div class=\"si-spk-guide\"><strong>DDNSTO · SPK 套件</strong><p>1. 访问 <a href=\"https://fw.koolcenter.com/binary/ddnsto/synology/\" target=\"_blank\" rel=\"noopener noreferrer\">群晖 DDNSTO 套件下载页</a></p><p>2. 按 DSM 版本和 CPU 架构选择对应套件包：</p><div class=\"si-spk-grid\"><div><span>DSM 7.x</span><code>ddnsto-x.x.x-7.x.spk</code></div><div><span>DSM 6.x</span><code>ddnsto-x.x.x-6.x.spk</code></div><div><span>X86 架构</span><code>ddnsto_x86-xxx.spk</code></div><div><span>ARM 架构（DS223、DS124 等）</span><code>ddnsto_arm-xxx.spk</code></div></div></div></div></div>"
      },
      {
        "title": "手动安装",
        "text": "打开 DSM → 套件中心 → 手动安装，点击「浏览」选择 .spk 文件，再点击「下一步」。",
        "kind": "design",
        "links": [
          {
            "label": "查看配置详情",
            "url": "https://doc.linkease.com/zh/guide/ddnsto/quickstart/install-guide/synology.html#安装步骤"
          }
        ],
        "illustrationHtml": "<div class=\"si-window\" role=\"img\" aria-label=\"群晖：手动安装，界面示意\"><div class=\"si-window-bar\"><span class=\"si-dots\">● ● ●</span><span>群晖</span><small>界面示意</small></div><div class=\"si-window-content si-synology-content\"><div class=\"synology-install\"><div class=\"synology-toolbar\"><strong>套件中心</strong><span class=\"synology-search\">搜索套件</span><b class=\"synology-highlight\">手动安装</b></div><div class=\"synology-dialog\"><div class=\"synology-dialog-title\">手动安装 <span>×</span><strong>上传套件</strong></div><div class=\"synology-dialog-body\"><p>选择已下载的 .spk 套件文件</p><div class=\"synology-file\"><span>文件</span><code>ddnsto-… .spk</code><b class=\"synology-highlight\">浏览</b></div></div><div class=\"synology-dialog-footer\"><span class=\"synology-next\">下一步</span></div></div></div></div></div>"
      },
      {
        "title": "填入令牌",
        "text": "在「Token 设置」填入从控制台获取的账号令牌，设备编号保持默认，点击「下一步」完成安装。",
        "kind": "design",
        "links": [
