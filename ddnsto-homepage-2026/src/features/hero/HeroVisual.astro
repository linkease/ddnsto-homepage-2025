---
import Icon from '@/components/ui/Icon.astro';
---

<div
  id="hero-animation"
  class="hero-visual"
  aria-label="远程使用场景动画（模拟）"
>
  <div class="visual-window desktop" data-visual="computer" aria-hidden="true">
    <div class="browser-tabs">
      <span class="traffic"><i></i><i></i><i></i></span><div
        class="browser-tab"
      >
        <Icon name="monitor" />Remote Desktop <span class="tab-close">×</span>
      </div>
    </div>
    <div class="address-bar">
      <div>
        <Icon name="lock" /><span>https://</span><span class="address"
          >app.ddnsto.com/vnc</span
        >
      </div>
    </div>
    <div class="desktop-body">
      <div class="desktop-icons">
        <div class="desktop-icon pc">
          <span><Icon name="monitor" /></span><small>My PC</small>
        </div><div class="desktop-icon">
          <Icon name="trash" /><small>Recycle Bin</small>
        </div>
      </div><span class="pointer"><Icon name="cursor" /></span><div
        class="pc-window"
      >
        <div class="mini-title">My PC <span>−　□　×</span></div><div
          class="folders"
        >
          <span><Icon name="folder" />Documents</span><span
            ><Icon name="folder" />Pictures</span
          ><span><Icon name="folder" />Downloads</span>
        </div>
      </div><div class="taskbar">
        <span class="windows-mark"><i></i><i></i><i></i><i></i></span><span
          >10:24 AM</span
        >
      </div>
    </div>
  </div>
  <div
    class="visual-window home-assistant"
    data-visual="software"
    hidden
    aria-hidden="true"
  >
    <div class="home-bar"><span>● ● ●</span>Home Assistant · 智能家居</div><div
      class="home-body"
    >
      <div class="home-title">我的家<small>远程连接 · 演示</small></div><div
        class="home-cards"
      >
        <div class="home-card light">
          客厅灯 <span class="toggle"></span><strong>☀</strong><small
            class="light-status">已关闭</small
          >
        </div><div class="home-card">
          客厅温度<strong>24°C</strong><small>室内环境舒适</small>
        </div>
      </div><div class="home-status">远程连接家中的 Home Assistant</div>
      <span class="pointer"><Icon name="cursor" /></span>
    </div>
  </div>
  <div
    class="visual-window file-manager"
    data-visual="files"
    hidden
    aria-hidden="true"
  >
    <div class="mini-title">
      <span class="traffic"><i></i><i></i><i></i></span>File Manager
    </div><div class="file-columns">
      <span>Name</span><span>Type</span><span>Size</span>
    </div><div class="file-rows">
      {
        [
          { name: 'Photos', type: 'Folder', size: '-', icon: 'folder' },
          {
            name: 'Project.doc',
            type: 'Document',
            size: '2.4 MB',
            icon: 'file',
          },
          { name: 'Holiday.mp4', type: 'Video', size: '1.2 GB', icon: 'film' },
          { name: 'Setup.exe', type: 'Program', size: '45 MB', icon: 'chip' },
          { name: 'Design.png', type: 'Image', size: '3.1 MB', icon: 'image' },
        ].map((row) => (
          <div class="file-row">
            <>
              <span>
                <Icon
                  name={
                    row.icon as 'folder' | 'file' | 'film' | 'chip' | 'image'
                  }
                />
                {row.name}
              </span>
              <span>{row.type}</span>
              <span>{row.size}</span>
            </>
          </div>
        ))
      }
    </div><div class="file-menu">
      <span>↓ 下载文件</span><span>查看属性</span>
    </div><span class="pointer"><Icon name="cursor" /></span><div
      class="file-transfer"
    >
      Project.doc <span>正在下载…</span><i></i>
    </div><div class="file-bottom">
      <span>5 items</span><span>Free space: 450 GB</span>
    </div>
  </div>
  <div
    class="visual-window router"
    data-visual="device"
    hidden
    aria-hidden="true"
  >
    <div class="router-bar">
      <span class="traffic"><i></i><i></i><i></i></span><div>
        <Icon name="lock" /><span>https://</span> myrouter.ddnsto.com
      </div>
    </div><div class="router-body">
      <div class="router-sidebar">
        <span><Icon name="activity" /></span><span><Icon name="wifi" /></span
        ><span><Icon name="globe" /></span><span><Icon name="terminal" /></span>
      </div><div class="router-content">
        <div class="router-status">
          <strong>系统状态</strong><i></i><div class="status-bars">
            <div>处理器负载<span><b></b></span></div><div>
              内存使用<span><b></b></span>
            </div>
          </div>
        </div><div class="router-cards">
          <div>
            <small>设备地址</small><span>192.168.1.2</span><span
              class="connected">已连接</span
            >
          </div><div>
            <small>无线网络</small><span>DDNSTO_5G</span><span
              class="device-count">5 台设备</span
            >
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
<style>
  .hero-visual {
    height: 310px;
    width: 100%;
    min-width: 0;
    font-size: 14px;
    line-height: 1.5;
  }
  .visual-window {
    height: 100%;
    position: relative;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: 12px;
    background: white;
    color: var(--color-text);
  }
  .hero-visual :global(svg) {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
    vertical-align: middle;
  }
  .traffic {
    display: flex;
    gap: 5px;
    flex-shrink: 0;
  }
  .traffic i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #ff6474;
  }
  .traffic i:nth-child(2) {
    background: #f3c349;
  }
  .traffic i:nth-child(3) {
    background: #64d99b;
  }
  .browser-tabs {
    display: flex;
    gap: 10.5px;
    align-items: center;
    background: var(--color-subtle);
    padding: 7px 10.5px;
    height: 36px;
  }
  .browser-tab {
    position: relative;
    top: 7px;
    display: flex;
    gap: 7px;
    align-items: center;
    background: white;
    border-radius: 7px 7px 0 0;
    padding: 3.5px 10.5px;
    font-size: 10px;
    font-weight: 500;
    line-height: 15px;
  }
  .browser-tab :global(svg) {
    width: 10.5px;
    height: 10.5px;
    color: var(--color-link);
  }
  .tab-close {
    color: var(--color-muted);
    font-size: 12px;
    margin-left: 3px;
  }
  .address-bar {
    background: var(--color-subtle);
    padding: 0 10.5px 7px;
  }
  .address-bar > div {
    display: flex;
    align-items: center;
    gap: 7px;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: white;
    padding: 3.5px 10.5px;
    font-size: 10px;
    line-height: 15px;
  }
  .address-bar :global(svg) {
    width: 9px;
    height: 9px;
    color: #187348;
  }
  .address-bar > div > span:first-of-type {
    color: #187348;
  }
  .address {
    color: var(--color-text);
  }
  .desktop {
    display: flex;
    flex-direction: column;
  }
  .desktop-body {
    position: relative;
    flex: 1;
    background: var(--color-soft);
    padding: 14px;
    overflow: hidden;
  }
  .desktop-icons {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .desktop-icon {
    width: 42px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3.5px;
  }
  .desktop-icon > span {
    padding: 3.5px;
    border-radius: 4px;
    display: block;
  }
  .desktop-icon :global(svg) {
    width: 28px;
    height: 28px;
    filter: drop-shadow(0 3px 2px #14243b20);
  }
  .desktop-icon small {
    font-size: 10px;
    line-height: 12.5px;
    text-align: center;
  }
  .taskbar {
    position: absolute;
    bottom: 0;
    inset-inline: 0;
    height: 21px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0 7px;
    background: var(--color-subtle);
    font:
      8px/12px ui-monospace,
      monospace;
  }
  .windows-mark {
    display: grid;
    grid-template-columns: repeat(2, 3.5px);
    gap: 1px;
  }
  .windows-mark i {
    height: 3.5px;
    background: #398cff;
  }
  .pointer {
    position: absolute;
    top: 0;
    left: 0;
    width: 14px;
    height: 14px;
    line-height: 0;
    pointer-events: none;
    z-index: 2;
    filter: drop-shadow(0 3px 3px #14243b44);
  }
  .pointer :global(svg) {
    width: 14px;
    height: 14px;
    fill: var(--color-text);
    stroke: var(--color-text);
  }
  .pc-window {
    position: absolute;
    top: 20px;
    left: 85px;
    right: 16px;
    background: white;
    border: 1px solid var(--color-control);
    border-radius: 6px;
    opacity: 0;
    transform: scale(0.96);
    transition:
      opacity 0.3s,
      transform 0.3s;
  }
  .mini-title {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 5px 14px;
    background: var(--color-subtle);
    font-size: 10px;
    font-weight: 600;
    line-height: 18px;
  }
  .mini-title > span:last-child:not(.traffic) {
    margin-left: auto;
  }
  .folders {
    display: flex;
    gap: 24px;
    padding: 24px;
    font-size: 10px;
  }
  .folders span {
    display: flex;
    align-items: center;
    flex-direction: column;
    gap: 8px;
  }
  .folders :global(svg) {
    width: 30px;
    height: 30px;
    color: #d5a849;
    fill: #ffdb7b;
  }
  .home-bar {
    display: flex;
    gap: 16px;
    padding: 14px 18px;
    border-bottom: 1px solid var(--color-border);
    background: var(--color-subtle);
    font-size: 12px;
  }
  .home-bar > span {
    opacity: 0.45;
  }
  .home-body {
    padding: 22px;
  }
  .home-title {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 16px;
    font-weight: 600;
    color: var(--color-body);
  }
  .home-title small {
    font-size: 11px;
    font-weight: 400;
    color: #187348;
  }
  .home-cards {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
    margin-top: 20px;
  }
  .home-card {
    padding: 18px;
    border: 1px solid var(--color-border);
    border-radius: 10px;
    background: var(--color-subtle);
    font-size: 13px;
    color: var(--color-body);
  }
  .home-card strong {
    display: block;
    font-size: 25px;
    margin: 12px 0;
    color: var(--color-link);
  }
  .home-card small {
    display: block;
    color: var(--color-muted);
  }
  .light {
    background: var(--color-soft);
  }
  .toggle {
    display: inline-block;
    width: 32px;
    height: 18px;
    border-radius: 20px;
    background: var(--color-control);
    vertical-align: middle;
    margin-left: 8px;
  }
  .toggle:after {
    content: '';
    display: block;
    width: 12px;
    height: 12px;
    background: white;
    border-radius: 50%;
    margin: 3px;
    transition: transform 0.3s;
  }
  .home-status {
    font-size: 12px;
    color: var(--color-muted);
    margin-top: 14px;
  }
  .file-columns,
  .file-row {
    display: grid;
    grid-template-columns: 50% 35% 15%;
    gap: 8px;
    font-size: 10px;
    line-height: 15px;
  }
  .file-columns {
    color: var(--color-muted);
    padding: 10px 14px;
  }
  .file-rows {
    padding: 0 7px;
  }
  .file-row {
    padding: 6px 7px;
    margin-bottom: 3px;
    background: var(--color-subtle);
    border-radius: 3px;
  }
  .file-row > span:first-child {
    display: flex;
    gap: 7px;
    align-items: center;
  }
  .file-row > span:not(:first-child) {
    color: var(--color-muted);
  }
  .file-row :global(svg) {
    width: 12px;
    height: 12px;
    color: var(--color-link);
  }
  .file-row:first-child :global(svg) {
    color: #946200;
  }
  .file-row:nth-child(3) :global(svg) {
    color: #ff4263;
  }
  .file-row:nth-child(4) :global(svg) {
    color: var(--color-muted);
  }
  .file-bottom {
    position: absolute;
    bottom: 0;
    inset-inline: 0;
    display: flex;
    justify-content: space-between;
    padding: 3px 10px;
    background: var(--color-subtle);
    font-size: 10px;
    line-height: 16px;
    color: var(--color-muted);
  }
  .file-transfer {
    position: absolute;
    bottom: 32px;
    left: 20px;
    right: 20px;
    font-size: 11px;
    opacity: 0;
    transition: opacity 0.3s;
  }
  .file-transfer > span {
    float: right;
    color: var(--color-muted);
  }
  .file-transfer > i {
    display: block;
    margin-top: 8px;
    height: 4px;
    width: 100%;
    transform: scaleX(0);
    transform-origin: left;
    background: var(--color-accent);
    border-radius: 4px;
  }
  .router-bar {
    display: flex;
    align-items: center;
    gap: 18px;
    padding: 7px 14px;
    background: var(--color-subtle);
    font-size: 10px;
  }
  .router-bar > div {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 2px 10px;
    border: 1px solid var(--color-border);
    border-radius: 3px;
    flex: 1;
  }
  .router-bar :global(svg) {
    width: 10px;
    height: 10px;
    color: #187348;
  }
  .router-bar > div > span {
    color: var(--color-muted);
  }
  .router-body {
    display: flex;
    gap: 10px;
    padding: 10px;
    height: calc(100% - 38px);
  }
  .router-sidebar {
    width: 42px;
    flex-shrink: 0;
    border: 1px solid var(--color-border);
    border-radius: 7px;
    background: var(--color-subtle);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    padding: 8px;
    color: var(--color-muted);
    font-size: 20px;
  }
  .router-sidebar > span:first-child {
    color: var(--color-link);
  }
  .router-content {
    flex: 1;
    min-width: 0;
    font-size: 10px;
    line-height: 16px;
  }
  .router-status {
    position: relative;
    padding: 10px;
    border: 1px solid var(--color-border);
    border-radius: 7px;
    background: var(--color-subtle);
  }
  .router-status > i {
    position: absolute;
    top: 14px;
    right: 12px;
    width: 5px;
    height: 5px;
    background: #21c65b;
    border-radius: 50%;
  }
  .status-bars {
    display: flex;
    gap: 16px;
    color: var(--color-muted);
    margin-top: 6px;
  }
  .status-bars > div {
    flex: 1;
  }
  .status-bars span {
    display: block;
    margin-top: 3px;
  }
  .status-bars b {
    display: block;
    width: 65%;
    height: 5px;
    background: var(--color-accent);
    border-radius: 3px;
  }
  .status-bars > div + div b {
    width: 58%;
  }
  .router-cards {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    margin-top: 10px;
  }
  .router-cards > div {
    display: flex;
    flex-direction: column;
    gap: 3px;
    border: 1px solid var(--color-border);
    border-radius: 7px;
    padding: 7px;
    background: var(--color-subtle);
  }
  .router-cards small {
    font-size: 10px;
    color: var(--color-muted);
  }
  .connected {
    color: #187348;
  }
  .device-count {
    color: var(--color-link);
  }
  :global(.hero[data-phase='1']) .pc > span {
    background: #c7ddff;
  }
  :global(.hero[data-phase='2']) .pc-window,
  :global(.hero[data-phase='3']) .pc-window {
    opacity: 1;
    transform: scale(1);
  }
  :global(.hero[data-light-on='true']) .toggle {
    background: var(--color-accent);
  }
  :global(.hero[data-light-on='true']) .toggle:after {
    transform: translateX(14px);
  }
  :global(.hero[data-light-on='true']) .light strong {
    color: #dfad28;
  }
  :global(.hero[data-phase='2']) .file-transfer,
  :global(.hero[data-phase='3']) .file-transfer {
    opacity: 1;
  }
  :global(.hero:not([data-phase='0'])) .file-row:nth-child(2) {
    background: var(--color-soft);
  }
  .status-bars b {
    width: 100%;
    transform-origin: left;
  }
  .status-bars > div + div b {
    width: 100%;
  }
  .file-menu {
    position: absolute;
    top: 120px;
    left: 32%;
    width: 112px;
    background: white;
    border: 1px solid var(--color-border);
    border-radius: 5px;
    box-shadow: 0 4px 14px #14243b20;
    padding: 4px;
    font-size: 10px;
    opacity: 0;
    pointer-events: none;
  }
  .file-menu span {
    display: block;
    padding: 6px;
  }
  .file-menu span:first-child {
    background: var(--color-soft);
    color: var(--color-link);
  }
  :global(.hero[data-file-menu='true']) .file-menu {
    opacity: 1;
  }
  .pointer[data-clicking='true']::after {
    content: '';
    position: absolute;
    left: -5px;
    top: -5px;
    width: 15px;
    height: 15px;
    border: 2px solid #398cff80;
    border-radius: 50%;
  }
  @media (max-width: 600px) {
    .hero-visual {
      height: 270px;
    }
    .home-body {
      padding: 16px;
    }
    .home-card {
      padding: 12px;
    }
    .home-cards {
      gap: 10px;
      margin-top: 12px;
    }
    .folders {
      gap: 14px;
      padding: 20px 8px;
    }
    .folders :global(svg) {
      width: 24px;
      height: 24px;
    }
  }
  .file-columns,
  .file-row {
    gap: 0;
  }
  .file-columns > span:last-child,
  .file-row > span:last-child {
    text-align: right;
  }
  .router-sidebar :global(svg) {
    width: 17.5px;
    height: 17.5px;
  }
  .router-bar {
    line-height: 18px;
  }
  .traffic {
    gap: 5.25px;
  }
  .traffic i {
    width: 8.75px;
    height: 8.75px;
  }
</style>
