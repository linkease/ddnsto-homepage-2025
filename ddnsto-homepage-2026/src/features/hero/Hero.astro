---
import HeroDiagram from './HeroDiagram.astro';
import './hero.css';
const steps = ['安装被控客户端', '控制台管理设备和域名', '手机电脑随处访问'];
---

<section class="hero refresh-surface" aria-labelledby="hero-heading">
  <div class="hero-glow hero-glow-primary" aria-hidden="true"></div>
  <div class="hero-glow hero-glow-secondary" aria-hidden="true"></div>
  <div class="hero-grid refresh-container">
    <div class="hero-copy">
      <h1 id="hero-heading"><span>远程访问，</span><span>如此简单。</span></h1>
      <p class="hero-value">
        用手机、电脑的浏览器，随时随地远程设备及其局域网应用。
      </p>
      <p class="hero-install-label">安装到你想远程的被控设备上</p>
      <div class="hero-downloads">
        <a
          class="hero-download primary"
          data-download="windows"
          href="https://fw.koolcenter.com/binary/ddnsto/windows/ddnsto_windows_gui_4.2.9.zip"
          ><strong>Windows 下载</strong><small>安装包 · 下载后解压运行</small
          ></a
        >
        <a
          class="hero-download"
          data-download="macos"
          data-install-platform="macos"
          href="?platform=macos#devices"
          ><strong>macOS 安装</strong><small>命令行 · 查看安装方法</small></a
        >
      </div>
      <div class="hero-install-links">
        <span>其他安装方式</span>
        <a data-install-platform="asusgo" href="?platform=asusgo#devices"
          >华硕</a
        >
        <a data-install-platform="openwrt" href="?platform=openwrt#devices"
          >OpenWrt</a
        >
        <a href="#devices">其他设备</a>
        <a href="#install-options">一键脚本安装</a>
      </div>
    </div>
    <hero-onboarding
      class="hero-workflow"
      data-hero-active="0"
      data-running="false"
      aria-label="开始使用 DDNSTO 的模拟演示"
    >
      <div
        class="hero-workflow-panel"
        id="hero-workflow-panel"
        role="tabpanel"
        aria-labelledby="hero-step-0"
        tabindex="0"
      >
        <HeroDiagram />
      </div>
      <div
        class="hero-workflow-steps"
        role="tablist"
        aria-label="开始使用的三个步骤"
      >
        {
          steps.map((title, i) => (
            <button
              type="button"
              role="tab"
              id={`hero-step-${i}`}
              aria-selected={i === 0}
              aria-controls="hero-workflow-panel"
              tabindex={i === 0 ? 0 : -1}
              data-hero-step={i}
            >
              <>
                <b>{i + 1}</b>
                <strong>{title}</strong>
              </>
            </button>
          ))
        }
      </div>
      <button
        class="hero-motion-toggle"
        aria-label="暂停首屏动画"
        aria-pressed="false"
        hidden>暂停</button
      >
    </hero-onboarding>
  </div>
</section>
<script>
  import { HeroOnboarding } from './controller';
  if (!customElements.get('hero-onboarding'))
    customElements.define('hero-onboarding', HeroOnboarding);
  const isMac = /Mac/i.test(navigator.platform) && navigator.maxTouchPoints < 2;
  document.querySelectorAll<HTMLElement>('[data-download]').forEach((link) => {
    const primary = link.dataset.download === (isMac ? 'macos' : 'windows');
    link.classList.toggle('primary', primary);
    link.style.order = primary ? '0' : '1';
  });
</script>
