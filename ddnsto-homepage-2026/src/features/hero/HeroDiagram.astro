---
import { site } from '@/config/site';
import './diagram.css';
---

<div class="hero-workflow-diagram" data-hero-panel="0">
  <div
    class="install-story"
    aria-label="选择华硕，在软件中心安装 DDNSTO，扫码生成设备的外网访问链接"
  >
    <div class="install-story-grid" aria-hidden="true">
      <div class="story-card">EasePi</div><div class="story-card">
        iStoreOS
      </div><div class="story-card story-card-placeholder">华硕</div><div
        class="story-card"
      >
        Koolcenter Lede
      </div><div class="story-card">OpenWrt</div><div class="story-card">
        群晖
      </div><div class="story-card">威联通</div><div class="story-card">
        Docker
      </div><div class="story-card">飞牛</div><div class="story-card">
        Padavan
      </div><div class="story-card">ReadyNAS</div><div class="story-card">
        爱快
      </div><div class="story-card">Unraid</div><div class="story-card">
        铁威马
      </div><div class="story-card">Windows</div><div class="story-card">
        Linux
      </div><div class="story-card">极空间</div><div class="story-card">
        绿联NAS
      </div><div class="story-card">macOS</div>
    </div><div class="story-asus">
      <div class="story-asus-label">ASUS <span>华硕</span></div><div
        class="story-store"
      >
        <div class="story-store-bar">
          <strong>ASUS</strong><span>软件中心</span><i>•••</i>
        </div><div class="story-store-body">
          <div class="story-store-search">搜索应用<span>DDNSTO</span></div><div
            class="story-app"
          >
            <img
              src="/images/brand/ddnsto-mark.svg"
              alt=""
              width="30"
              height="30"
            /><div>
              <strong>DDNSTO</strong><small>远程访问你的设备</small>
            </div><div class="story-install-state">
              <span class="story-install-idle">安装</span><span
                class="story-install-progress">安装中<i></i></span
              ><span class="story-install-done">✓ 已安装</span>
            </div>
          </div><div class="story-scan">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="32"
              height="32"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="lucide lucide-qr-code"
              aria-hidden="true"
              ><rect width="5" height="5" x="3" y="3" rx="1"></rect><rect
                width="5"
                height="5"
                x="16"
                y="3"
                rx="1"></rect><rect width="5" height="5" x="3" y="16" rx="1"
              ></rect><path d="M21 16h-3a2 2 0 0 0-2 2v3"></path><path
                d="M21 21v.01"></path><path d="M12 7v3a2 2 0 0 1-2 2H7"
              ></path><path d="M3 12h.01"></path><path d="M12 3h.01"
              ></path><path d="M12 16v.01"></path><path d="M16 12h1"
              ></path><path d="M21 12v.01"></path><path d="M12 21v-1"
              ></path></svg
            ><svg
              xmlns="http://www.w3.org/2000/svg"
              width="25"
              height="25"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="lucide lucide-smartphone"
              aria-hidden="true"
              ><rect width="14" height="20" x="5" y="2" rx="2" ry="2"
              ></rect><path d="M12 18h.01"></path></svg
            ><span>微信扫码，自动配置</span><b>✓</b>
          </div><div class="story-generated">
            <small>这台华硕的外网访问链接</small><span
              >https://myrouter.ddnsto.com</span
            >
          </div>
        </div><small class="story-store-note"
          >适用于支持软件中心的华硕固件</small
        >
      </div>
    </div>
  </div>
</div>
<div class="hero-workflow-diagram" data-hero-panel="1" hidden>
  <div class="story-console">
    <div class="story-console-header">
      <img
        alt=""
        src="/images/brand/ddnsto-mark.svg"
        width="30"
        height="30"
      /><strong>DDNSTO</strong><a
        href={site.consoleUrl}
        data-console-section="hero"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="免费使用，进入设备工作台">设备工作台</a
      >
    </div><div class="console-workspace">
      <aside class="console-sidebar">
        <span class="selected">▦ 设备工作台</span><span>▤ 设备套餐</span><span
          >◷ 访问统计</span
        ><span>▧ 使用教程</span>
      </aside><div class="console-main">
        <div class="console-toolbar">
          <span>我的设备 <b>1</b></span><small>● 1 台在线</small>
        </div><div class="console-device-card">
          <div class="story-console-device">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="28"
              height="28"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="lucide lucide-monitor"
              aria-hidden="true"
              ><rect width="20" height="14" x="2" y="3" rx="2"></rect><line
                x1="8"
                x2="16"
                y1="21"
                y2="21"></line><line x1="12" x2="12" y1="17" y2="21"
              ></line></svg
            ><strong>家里的华硕</strong><small>● 在线</small>
          </div><div class="story-console-link">
            <span>https://myrouter.ddnsto.com</span><div
              class="story-domain-actions"
            >
              <span>编辑</span><span>删除</span>
            </div>
          </div><div class="story-more-services">
            <span>＋ 添加更多服务</span><small>为局域网应用添加访问链接</small>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
<div class="hero-workflow-diagram" data-hero-panel="2" hidden>
  <div class="access-pair">
    <div class="hero-access-label">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="lucide lucide-monitor"
        aria-hidden="true"
        ><rect width="20" height="14" x="2" y="3" rx="2"></rect><line
          x1="8"
          x2="16"
          y1="21"
          y2="21"></line><line x1="12" x2="12" y1="17" y2="21"></line></svg
      ><span>电脑浏览器</span><svg
        xmlns="http://www.w3.org/2000/svg"
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="lucide lucide-smartphone"
        aria-hidden="true"
        ><rect width="14" height="20" x="5" y="2" rx="2" ry="2"></rect><path
          d="M12 18h.01"></path></svg
      ><span>手机浏览器</span>
    </div><div class="access-pair-devices">
      <div class="access-browser access-computer">
        <div class="access-address">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="11"
            height="11"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="lucide lucide-lock"
            aria-hidden="true"
            ><rect width="18" height="11" x="3" y="11" rx="2" ry="2"
            ></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg
          ><span><i>https://myrouter.ddnsto.com</i></span>
        </div><div class="access-screen">
          <div class="access-loading">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="lucide lucide-loader-circle animate-spin"
              aria-hidden="true"
              ><path d="M21 12a9 9 0 1 1-6.219-8.56"></path></svg
            >
          </div><div class="access-page">
            <header><strong>ASUS</strong><small>● 在线</small></header><p>
              路由器管理
            </p><div class="access-stat">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="lucide lucide-globe"
                aria-hidden="true"
                ><circle cx="12" cy="12" r="10"></circle><path
                  d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"
                ></path><path d="M2 12h20"></path></svg
              ><span>网络连接正常</span>
            </div><div class="access-metrics">
              <span>Wi-Fi<b>2.4 / 5 GHz</b></span><span>已连接设备<b>8</b></span
              >
            </div><div class="access-page-line"></div><div
              class="access-page-line short"
            >
            </div>
          </div>
        </div>
      </div><div class="access-browser access-mobile">
        <div class="access-speaker"></div><div class="access-address">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="11"
            height="11"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="lucide lucide-lock"
            aria-hidden="true"
            ><rect width="18" height="11" x="3" y="11" rx="2" ry="2"
            ></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg
          ><span><i>https://myrouter.ddnsto.com</i></span>
        </div><div class="access-screen">
          <div class="access-loading">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="lucide lucide-loader-circle animate-spin"
              aria-hidden="true"
              ><path d="M21 12a9 9 0 1 1-6.219-8.56"></path></svg
            >
          </div><div class="access-page">
            <header><strong>ASUS</strong><small>● 在线</small></header><p>
              路由器管理
            </p><div class="access-stat">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="lucide lucide-globe"
                aria-hidden="true"
                ><circle cx="12" cy="12" r="10"></circle><path
                  d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"
                ></path><path d="M2 12h20"></path></svg
              ><span>网络连接正常</span>
            </div><div class="access-metrics">
              <span>Wi-Fi<b>2.4 / 5 GHz</b></span><span>已连接设备<b>8</b></span
              >
            </div><div class="access-page-line"></div><div
              class="access-page-line short"
            >
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
