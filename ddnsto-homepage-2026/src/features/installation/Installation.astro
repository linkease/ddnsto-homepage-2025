---
import { supportSource } from '@/content/installation';
import { platforms, ikuaiVideoUrl } from '@/content/homeInstallation';
import {
  offlineDirectories,
  terminalPlatforms,
} from '@/content/installMethods';
import { illustration } from './illustration';
import Methods from './Methods.astro';
import ContainerGuide from './ContainerGuide.astro';
import TokenScanDialog from './TokenScanDialog.astro';
import './platform-guides.css';
import './installation.css';
const mainPlatforms = platforms.filter(
  (p) => !['lede', 'readynas'].includes(p.id),
);
const groups = [
  {
    label: '路由器与 NAS',
    items: mainPlatforms.filter((p) => p.group === '路由器与 NAS'),
  },
  {
    label: '电脑与通用环境',
    items: mainPlatforms.filter((p) => p.group === '电脑与通用环境'),
  },
  {
    label: '终端安装',
    items: [
      // 暂时隐藏 Windows 终端入口；取消下一行注释即可恢复，安装逻辑保留。
      // terminalPlatforms[0],
      terminalPlatforms[1],
    ],
  },
];
---

<section
  id="devices"
  class="installation-section install-preview refresh-surface"
  aria-labelledby="install-title"
>
  <div class="refresh-container">
    <div class="section-head install-title">
      <h2 id="install-title">你的设备<span>怎么用</span></h2><p>
        选择安装 DDNSTO 的远端设备，而不是你当前用来浏览网页的手机或电脑。
      </p><small
        >支持设备与系统以<a
          href={supportSource}
          target="_blank"
          rel="noopener noreferrer">官方支持列表</a
        >为准。</small
      >
    </div>
    <installation-guide>
      <p class="selection-status" role="status" data-selection-status hidden>
      </p>
      <div class="device-layout install-layout" id="platform-install-guide">
        <div
          class="install-platforms"
          id="platforms"
          role="group"
          aria-label="设备平台"
        >
          {
            groups.map((group) => (
              <div>
                <>
                  <h3>{group.label}</h3>
                  <div
                    class:list={[
                      'install-platform-grid',
                      { 'install-terminal-grid': group.label === '终端安装' },
                    ]}
                  >
                    {group.items.map((p) => (
                      <button
                        type="button"
                        data-platform={p.id}
                        aria-pressed={p.id === 'easepi'}
                        aria-controls="platform-guide"
                      >
                        {p.id === 'asusgo' ? '华硕' : p.label}
                        <span aria-hidden="true">✓</span>
                      </button>
                    ))}
                  </div>
                </>
              </div>
            ))
          }
          <noscript
            ><p>选择下方设备安装说明：</p><ul>
              {
                platforms.map((p) => (
                  <li>
                    <a href={`#install-${p.id}`}>{p.label}</a>
                  </li>
                ))
              }
            </ul></noscript
          >
        </div>
        <div class="install-guide" id="platform-guide">
          <div class="si-heading">
            <h3 data-platform-title>EasePi</h3><a
              data-platform-tutorial
              href={platforms[0].url}
              target="_blank"
              rel="noopener noreferrer">更多教程</a
            >
          </div>
          <div class="installation-methods" id="install-options">
            <div
              class="install-method-tabs"
              role="tablist"
              aria-label="安装方式"
            >
              {
                [
                  ['software', '软件安装'],
                  ['script', '一键脚本'],
                  ['ai', 'AI 帮我装'],
                  ['compose', 'Docker Compose'],
                  ['docker', '常规 Docker'],
                ].map(([key, label], i) => (
                  <button
                    type="button"
                    role="tab"
                    id={`method-${key}`}
                    data-method={key}
                    aria-selected={i === 0 ? 'true' : 'false'}
                    aria-controls={`method-${key}-panel`}
                    tabindex={i === 0 ? 0 : -1}
                    hidden={key === 'compose' || key === 'docker'}
                  >
                    <span data-method-label>{label}</span>
                    {(key === 'script' || key === 'compose') && (
                      <small>推荐</small>
                    )}
                  </button>
                ))
              }
            </div>
            <div
              data-method-panel="compose"
              id="method-compose-panel"
              role="tabpanel"
              aria-labelledby="method-compose"
              hidden
            >
              {
                (['fnos', 'docker', 'unraid', 'terramaster'] as const).map(
                  (id) => (
                    <div data-container-platform={id} hidden={id !== 'fnos'}>
                      <ContainerGuide platform={id} method="compose" />
                    </div>
                  ),
                )
              }
            </div>
            <div
              data-method-panel="docker"
              id="method-docker-panel"
              role="tabpanel"
              aria-labelledby="method-docker"
              hidden
            >
              {
                (
                  [
                    'fnos',
                    'docker',
                    'unraid',
                    'terramaster',
                    'zspace',
                    'ugreen',
                  ] as const
                ).map((id) => (
                  <div data-container-platform={id} hidden={id !== 'fnos'}>
                    <ContainerGuide platform={id} method="docker" />
                  </div>
                ))
              }
            </div>
            <div
              data-method-panel="software"
              id="method-software-panel"
              role="tabpanel"
              aria-labelledby="method-software"
            >
              {
                platforms.map((p, pi) => (
                  <article
                    class="platform-guide"
                    id={`install-${p.id}`}
                    data-guide={p.id}
                    hidden={pi !== 0}
                    aria-labelledby={`title-${p.id}`}
                  >
                    <h3 class="sr-only" id={`title-${p.id}`}>
                      {p.label}
                    </h3>
                    {p.branches.length > 0 && (
                      <div class="install-branches">
                        <label for={`branch-${p.id}`}>版本 / 类型</label>
                        <select
                          id={`branch-${p.id}`}
                          data-branch={p.id}
                          aria-describedby={`branch-note-${p.id}`}
                        >
                          {p.branches.map((b) => (
                            <option value={b.id}>{b.label}</option>
                          ))}
                        </select>
                        <p id={`branch-note-${p.id}`} data-branch-note>
                          {p.branches[0].note}
                        </p>
                        <noscript>
                          <ul>
                            {p.branches.map((b) => (
                              <li>
                                {b.label}：{b.note}
                              </li>
                            ))}
                          </ul>
                        </noscript>
                      </div>
                    )}
                    {p.id === 'ikuai' && (
                      <div class="ikuai-guide">
                        <a
                          class="ikuai-video-card"
                          href={ikuaiVideoUrl}
                          target="_blank"
                          rel="noopener noreferrer"
                          aria-label="爱快 DDNSTO 安装视频，在 B 站新窗口播放"
                        >
                          <div class="ikuai-video-bar">
                            <span>爱快 · DDNSTO 安装教程</span>
                            <small>B站视频</small>
                          </div>
                          <div class="ikuai-video-content">
                            <span class="ikuai-play" aria-hidden="true">
                              <svg
                                width="28"
                                height="28"
                                viewBox="0 0 24 24"
                                fill="currentColor"
                              >
                                <path d="M6 3.5a1.5 1.5 0 0 1 2.3-1.2l12 8a2 2 0 0 1 0 3.4l-12 8A1.5 1.5 0 0 1 6 20.5z" />
                              </svg>
                            </span>
                            <strong>爱快安装 DDNSTO</strong>
                            <span>点击前往 B 站播放</span>
                          </div>
                        </a>
                        <a
                          class="ikuai-doc-link"
                          href={p.url}
                          target="_blank"
                          rel="noopener noreferrer"
                        >
                          查看文档教程
                        </a>
                      </div>
                    )}
                    {p.id !== 'ikuai' && (
                      <div>
                        {p.steps.map((step, i) => (
                          <div data-step-panel={i} hidden={i !== 0}>
                            <div set:html={illustration(step, p, i)} />
                            <div class="si-copy">
                              <h4 class="sr-only">{step.title}</h4>
                              <p>
                                {step.text}
                                {p.id !== 'windows' && (
                                  <span class="platform-offline-link">
                                    <span>安装不了？</span>
                                    <a
                                      href={
                                        offlineDirectories[p.id]
                                          ? `https://fw.koolcenter.com/binary/ddnsto/${offlineDirectories[p.id]}/`
                                          : p.url
                                      }
                                      target="_blank"
                                      rel="noopener noreferrer"
                                    >
                                      {offlineDirectories[p.id]
                                        ? '下载离线包'
                                        : '查看对应安装方式'}
                                    </a>
                                  </span>
                                )}
                              </p>
                              {step.links.map((link, index) => (
                                <>
                                  {index > 0 && ' '}
                                  <a
                                    href={link.url}
                                    target="_blank"
                                    rel="noopener"
                                  >
                                    {link.label}
                                  </a>
                                </>
                              ))}
                            </div>
                          </div>
                        ))}
                        <div
                          class="si-steps"
                          style={`--si-step-count:${p.steps.length}`}
                          role="group"
                          aria-label={`${p.label}安装步骤`}
                        >
                          {p.steps.map((step, i) => (
                            <button
                              type="button"
                              data-install-step={i}
                              aria-pressed={i === 0}
                            >
                              <span>{i + 1}</span>
                              <b>{step.title}</b>
                            </button>
                          ))}
                        </div>
                        {p.note && <p class="si-note">{p.note}</p>}
                      </div>
                    )}
                  </article>
                ))
              }
            </div>
            <Methods />
          </div>
        </div>
      </div>
      <p class="sr-only" role="status" data-step-status></p>
    </installation-guide>
    <TokenScanDialog />
  </div>
  <noscript
    ><style>
      #devices #platforms button,
      #devices .si-steps,
      #devices .install-method-tabs,
      #devices [data-copy-id],
      #devices .script-scan-card,
      #devices select,
      #devices .install-branches > label,
      #devices [data-branch-note] {
        display: none !important;
      }
      #devices [data-guide][hidden],
      #devices [data-step-panel][hidden],
      #devices [data-method-panel][hidden] {
        display: block !important;
      }
      #devices .platform-guide {
        margin-bottom: 32px;
      }
      #devices .device-layout {
        display: block;
      }
    </style></noscript
  >
</section>
<script>
  import { InstallationGuide } from './controller';
  if (!customElements.get('installation-guide'))
    customElements.define('installation-guide', InstallationGuide);
</script>
