---
import { support } from '@/content/commerce';
import { faqHighlights } from '@/content/faqHighlights';
import './faq.css';
---

<section id="faq" class="faq-section refresh-surface">
  <div class="refresh-container">
    <div class="faq-heading">
      <h2>常见 <span>问题</span></h2><p>关于 DDNSTO 您需要知道的一切。</p>
    </div>
    <div class="faq-highlights">
      {
        faqHighlights.map((group) => (
          <div class="faq-highlight-group">
            <>
              <h3>{group.title}</h3>
              <div class="faq-highlight-panel">
                {group.items.map((item) => (
                  <details>
                    <summary>
                      {item.question}
                      <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M5 12h14" />
                        <path class="plus" d="M12 5v14" />
                      </svg>
                    </summary>
                    <p>{item.answer}</p>
                  </details>
                ))}
              </div>
            </>
          </div>
        ))
      }
    </div>
    <div class="faq-ai">
      <a href={support.ai} target="_blank" rel="noopener noreferrer"
        ><svg viewBox="0 0 24 24" aria-hidden="true"
          ><path d="M12 8V4H8M2 14h2m16 0h2M9 13v2m6-2v2"></path><rect
            x="4"
            y="8"
            width="16"
            height="12"
            rx="2"></rect></svg
        >更多疑问？问问 AI助手？</a
      >
    </div>
  </div>
</section>
