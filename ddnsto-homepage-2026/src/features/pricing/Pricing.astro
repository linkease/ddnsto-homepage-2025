---
import { commerce } from '@/content/commerce';
import './pricing.css';
---

<section
  id="pricing"
  class="pricing-section refresh-surface"
  aria-labelledby="pricing-title"
>
  <div class="pricing-glow" aria-hidden="true"></div>
  <div class="refresh-container">
    <div class="pricing-heading">
      <h2 id="pricing-title">简单、透明的 <span>价格</span></h2><p>
        免费使用，每个设备需绑定一个套餐，需要更多功能时升级。
      </p>
    </div>
    <div class="prices">
      {
        commerce.plans.map((plan) => (
          <article
            class={`package-card package-${plan.id}`}
            id={plan.id === 'advanced' ? 'advanced-plan' : undefined}
            tabindex={plan.id === 'advanced' ? -1 : undefined}
          >
            {plan.id === 'standard' && <div class="package-ribbon">推荐</div>}
            {plan.id === 'advanced' && (
              <>
                <span class="pricing-flash-ring" hidden aria-hidden="true" />
                <p class="pricing-target-label" hidden>
                  TCP 优惠对应此套餐
                </p>
              </>
            )}
            <div class="package-heading">
              <h3>{plan.title}</h3>
              {plan.description && <p>{plan.description}</p>}
            </div>
            <div class="package-price">
              <strong>{plan.price.split('/')[0]}</strong>
              {plan.price.includes('/') && (
                <span>/{plan.price.split('/')[1]}</span>
              )}
            </div>
            <ul>
              {plan.id === 'advanced' && (
                <li class="package-tcp">
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="m5 12 4 4L19 6" />
                  </svg>
                  <span>{commerce.tcpOffer.text}</span>
                </li>
              )}
              {plan.benefits.map((text) => (
                <li>
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="m5 12 4 4L19 6" />
                  </svg>
                  <span>{text}</span>
                </li>
              ))}
            </ul>
            {plan.id === 'bulk' && (
              <button type="button" class="package-contact" data-customer>
                联系客服
              </button>
            )}
            {plan.id !== 'bulk' && (
              <a
                class="package-buy"
                data-purchase-plan={plan.id}
                href={commerce.purchase}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`购买${plan.title}`}
              >
                购买
              </a>
            )}
          </article>
        ))
      }
    </div>
  </div>
</section>
