---
const steps = [
  [
    '安装客户端',
    '在您的 NAS 或路由器上安装轻量级客户端。',
    '<path d="M12 15V3M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4m4-5 5 5 5-5"/>',
  ],
  [
    '创建域名',
    '选择一个域名绑定到您的内部 Web 服务。',
    '<path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>',
  ],
  [
    '随处访问',
    '打开浏览器，安全地访问您的设备。',
    '<circle cx="12" cy="12" r="10"/><ellipse cx="12" cy="12" rx="4" ry="10"/><path d="M2 12h20"/>',
  ],
];
---

<details class="legacy-flow" id="manual-workflow">
  <summary>传统手动配置流程参考</summary>
  <p class="workflow-note">
    先按上方设备教程选择最简方式。以下演示适用于手动安装、令牌配置，不代表所有设备都需要手填令牌。
  </p>
  <manual-workflow data-active="0" data-paused>
    <section aria-labelledby="workflow-title">
      <header>
        <h2 id="workflow-title">手动配置 <span>流程参考</span></h2><p>
          适用于手动安装与令牌配置；快捷扫码请看对应设备教程。
        </p>
      </header>
      <div class="workflow-steps" aria-label="手动配置步骤">
        {
          steps.map(([title, description, shape], i) => (
            <button
              type="button"
              class="workflow-step"
              data-step={i}
              aria-pressed={i === 0}
              aria-controls="workflow-demo"
            >
              <>
                <span class="step-icon">
                  <>
                    <svg
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                      set:html={shape}
                    />
                    <b>{i + 1}</b>
                  </>
                </span>
                <strong>{title}</strong>
                <span class="step-description">{description}</span>
              </>
            </button>
          ))
        }
      </div>
      <div
        class="workflow-demo"
        id="workflow-demo"
        aria-label="手动配置流程模拟演示，非真实设备"
        data-nosnippet
      >
        <div class="workflow-scene" data-scene="0">
          <div class="setup-window">
            <div class="window-title">
              <span class="dots"><i></i><i></i><i></i></span>DDNSTO 客户端配置
            </div>
            <div class="field-label">令牌 TOKEN</div><div class="field">
              <span class="typing token"
                >ade32hnb-1481-3ks5-b446-ks6d313920ca</span
              >
            </div>
            <div class="service-row">
              <span class="service-status"
                ><i></i><span class="stopped">状态：已停止</span><span
                  class="running">状态：运行中</span
                ></span
              ><span class="demo-submit">启动服务</span>
            </div>
          </div>
        </div>
        <div class="workflow-scene" data-scene="1" hidden>
          <div class="setup-window mapping-window">
            <div class="window-title">添加域名映射</div><div
              class="field-label"
            >
              自定义域名
            </div><div class="field domain-field">
              <span class="typing domain">myrouter</span><span>.ddnsto.com</span
              >
            </div><div class="field-label">内网地址</div><div class="field">
              <span class="http-tag">HTTP</span> http://127.0.0.1
            </div><span class="demo-submit wide">✓ 提交</span>
          </div>
        </div>
        <div class="workflow-scene" data-scene="2" hidden>
          <div class="access-window">
            <div class="browser-bar">
              <span class="dots"><i></i><i></i><i></i></span><div class="url">
                <span>♧</span><span class="typing url-text"
                  >https://myrouter.ddnsto.com</span
                >
              </div>
            </div><div class="access-content">
              <span class="loading" aria-hidden="true"></span><div
                class="connected"
              >
                <span>✓</span><strong>连接成功</strong><small
                  >安全隧道已建立</small
                >
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </manual-workflow>
</details>
<script>
  import { ManualWorkflow } from './controller';
  if (!customElements.get('manual-workflow'))
    customElements.define('manual-workflow', ManualWorkflow);
</script>
<style>
  .legacy-flow {
    max-width: 1248px;
    margin: 30px auto;
    padding: 20px;
    border: 1px solid #d5e0ef;
    border-radius: 10px;
    color: var(--color-text);
    width: calc(100% - 32px);
  }
  .legacy-flow > summary {
    font-size: 14px;
    line-height: 24px;
    font-weight: 500;
    padding: 12px 0;
    color: var(--color-link);
    cursor: pointer;
  }
  .workflow-note {
    font-size: 13px;
    line-height: 24px;
    margin: 4px 0 20px;
  }
  manual-workflow {
    display: block;
    --workflow-play: running;
  }
  manual-workflow[data-paused] {
    --workflow-play: paused;
  }
  section {
    padding: 72px 21px;
    max-width: 1184px;
    margin-inline: auto;
  }
  header {
    text-align: center;
    margin-bottom: 56px;
  }
  h2 {
    font-size: 32px;
    line-height: 44.8px;
    margin: 0 0 14px;
    font-weight: 600;
  }
  h2 span {
    color: var(--color-link);
  }
  header p {
    font-size: 14px;
    line-height: 21px;
    color: var(--color-muted);
    margin: 0;
  }
  .workflow-steps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 28px;
    margin-bottom: 56px;
  }
  .workflow-step {
    appearance: none;
    border: 0;
    background: none;
    color: var(--color-text);
    font: inherit;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    cursor: pointer;
    padding: 0;
  }
  .step-icon {
    position: relative;
    width: 84px;
    height: 84px;
    display: grid;
    place-items: center;
    border: 1px solid var(--color-border);
    border-radius: 14px;
    background: white;
    margin-bottom: 21px;
    transition:
      transform 0.36s cubic-bezier(0.22, 1, 0.36, 1),
      border-color 0.36s ease,
      box-shadow 0.36s ease,
      background-color 0.36s ease,
      color 0.36s ease;
    color: var(--color-text);
  }
  .step-icon svg {
    width: 35px;
    height: 35px;
  }
  .step-icon b {
    position: absolute;
    right: -10.5px;
    top: -10.5px;
    width: 28px;
    height: 28px;
    display: grid;
    place-items: center;
    background: #f6f8fb;
    color: var(--color-muted);
    border: 1px solid var(--color-border);
    border-radius: 50%;
    font-size: 12.25px;
    font-weight: 700;
    transition:
      background-color 0.36s ease,
      border-color 0.36s ease,
      color 0.36s ease;
  }
  .workflow-step strong {
    transition: color 0.36s ease;
    font-size: 17.5px;
    line-height: 24.5px;
    margin-bottom: 7px;
    font-weight: 600;
  }
  .step-description {
    font-size: 12.25px;
    line-height: 17.5px;
    color: var(--color-muted);
  }
  .workflow-step[aria-pressed='true'] .step-icon {
    transform: scale(1.1);
    border-color: var(--color-link);
    color: var(--color-link);
    background: #e7efff;
    box-shadow: 0 0 35px #0060ff26;
  }
  .workflow-step[aria-pressed='true'] b {
    background: var(--color-link);
    border-color: var(--color-link);
    color: white;
  }
  .workflow-step[aria-pressed='true'] strong {
    color: var(--color-link);
  }
  .workflow-step:focus-visible {
    outline: 2px solid var(--color-link);
    outline-offset: 8px;
    border-radius: 8px;
  }
  .workflow-demo {
    position: relative;
    max-width: 672px;
    height: 300px;
    margin: auto;
    border: 1px solid var(--color-border);
    border-radius: 14px;
    overflow: hidden;
    background: white;
  }
  .workflow-scene {
    position: absolute;
    inset: 0;
    padding: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .workflow-scene[data-entering] {
    animation: workflow-enter 0.45s cubic-bezier(0.4, 0, 0.2, 1) both;
    animation-play-state: var(--workflow-play);
  }
  .workflow-scene[data-leaving] {
    animation: workflow-exit 0.45s cubic-bezier(0.4, 0, 0.2, 1) both;
    animation-play-state: var(--workflow-play);
    pointer-events: none;
  }
  @keyframes workflow-exit {
    from {
      opacity: 1;
      transform: translateY(0);
    }
    to {
      opacity: 0;
      transform: translateY(-6px);
    }
  }
  .workflow-scene[hidden] {
    display: none;
  }
  .setup-window {
    position: relative;
    overflow: hidden;
    width: 100%;
    max-width: 392px;
    border: 1px solid var(--color-border);
    border-radius: 7px;
    padding: 21px;
    background: white;
    font-size: 12.25px;
    line-height: 17.5px;
  }
  .window-title {
    display: flex;
    align-items: center;
    gap: 7px;
    margin-bottom: 21px;
    padding-bottom: 14px;
    border-bottom: 1px solid transparent;
    color: var(--color-muted);
  }
  .dots {
    display: flex;
    gap: 7px;
    margin-right: 7px;
    flex-shrink: 0;
  }
  .dots i {
    width: 10.5px;
    height: 10.5px;
    border-radius: 50%;
    background: #ff919a;
  }
  .dots i:nth-child(2) {
    background: #ffda7b;
  }
  .dots i:nth-child(3) {
    background: #83e4ae;
  }
  .field-label {
    font-size: 10.5px;
    line-height: 14px;
    color: var(--color-muted);
    margin-bottom: 3.5px;
  }
  .field {
    background: #f6f8fb;
    border: 1px solid var(--color-border);
    border-radius: 3.5px;
    padding: 7px 10.5px;
    line-height: 21px;
    min-height: 37px;
    overflow: hidden;
    white-space: nowrap;
  }
  .typing {
    display: inline-block;
    vertical-align: bottom;
    overflow: hidden;
    white-space: nowrap;
    animation: workflow-type 3s linear infinite;
    animation-play-state: var(--workflow-play);
  }
  .token {
    max-width: 100%;
  }
  .service-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 14px;
    padding-top: 7px;
  }
  .service-status {
    position: relative;
    display: flex;
    align-items: center;
    gap: 7px;
    width: 110px;
    font-size: 10.5px;
  }
  .service-status i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #16c55e;
  }
  .running,
  .stopped {
    position: absolute;
    left: 14px;
    white-space: nowrap;
    animation: workflow-running 3s linear infinite;
    animation-play-state: var(--workflow-play);
  }
  .running {
    color: #008568;
  }
  .stopped {
    animation-name: workflow-stopped;
    color: var(--color-muted);
  }
  .demo-submit {
    display: inline-block;
    border-radius: 3.5px;
    padding: 5.25px 14px;
    background: var(--color-link);
    color: white;
    font-size: 12.25px;
    font-weight: 600;
    line-height: 17.5px;
    animation: workflow-press 3s ease infinite;
    animation-play-state: var(--workflow-play);
  }
  .mapping-window .field {
    margin-bottom: 14px;
  }
  .domain-field {
    display: flex;
    justify-content: space-between;
    gap: 5px;
  }
  .domain-field > span:last-child {
    color: var(--color-muted);
  }
  .wide {
    display: block;
    text-align: center;
  }
  .http-tag {
    color: var(--color-link);
    background: #eaf1ff;
    padding: 2px 5px;
    font-size: 10.5px;
  }
  .access-window {
    width: 100%;
    max-width: 392px;
    height: 168px;
    border: 1px solid var(--color-border);
    border-radius: 7px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }
  .browser-bar {
    display: flex;
    align-items: center;
    gap: 10.5px;
    padding: 10.5px 14px;
    background: #f6f8fb;
  }
  .url {
    display: flex;
    align-items: center;
    gap: 7px;
    min-width: 0;
    height: 28px;
    border: 1px solid var(--color-border);
    border-radius: 5px;
    background: white;
    padding: 5px 10px;
    font-size: 10.5px;
  }
  .url > span:first-child {
    color: #008568;
  }
  .access-content {
    flex: 1;
    position: relative;
    display: grid;
    place-items: center;
  }
  .connected {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    animation: workflow-connected 3s linear infinite;
    animation-play-state: var(--workflow-play);
  }
  .connected > span {
    width: 35px;
    height: 35px;
    background: #e1f8eb;
    color: #16b75c;
    border-radius: 50%;
    display: grid;
    place-items: center;
    font-size: 22px;
  }
  .connected strong {
    font-size: 14px;
  }
  .connected small {
    font-size: 10.5px;
    color: var(--color-muted);
  }
  .loading {
    position: absolute;
    width: 28px;
    height: 28px;
    border: 3px solid #eaf1ff;
    border-top-color: var(--color-link);
    border-radius: 50%;
    animation:
      workflow-spin 1s linear infinite,
      workflow-loading 3s linear infinite;
    animation-play-state: var(--workflow-play);
  }
  @keyframes workflow-enter {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes workflow-type {
    0%,
    7% {
      clip-path: inset(0 100% 0 0);
    }
    40%,
    100% {
      clip-path: inset(0 0 0 0);
    }
  }
  @keyframes workflow-running {
    0%,
    35% {
      opacity: 0;
    }
    50%,
    100% {
      opacity: 1;
    }
  }
  @keyframes workflow-stopped {
    0%,
    35% {
      opacity: 1;
    }
    50%,
    100% {
      opacity: 0;
    }
  }
  @keyframes workflow-press {
    0%,
    50%,
    60%,
    100% {
      transform: scale(1);
    }
    55% {
      transform: scale(0.95);
    }
  }
  @keyframes workflow-spin {
    to {
      transform: rotate(360deg);
    }
  }
  @keyframes workflow-loading {
    0%,
    60% {
      opacity: 1;
    }
    70%,
    100% {
      opacity: 0;
    }
  }
  @keyframes workflow-connected {
    0%,
    65% {
      opacity: 0;
    }
    75%,
    100% {
      opacity: 1;
    }
  }
  @media (max-width: 767px) {
    section {
      padding: 50px 0;
    }
    h2 {
      font-size: 27px;
      line-height: 38px;
    }
    header {
      margin-bottom: 40px;
    }
    .workflow-steps {
      grid-template-columns: 1fr;
      gap: 32px;
      margin-bottom: 36px;
    }
    .workflow-scene {
      padding: 14px;
    }
    .setup-window {
      padding: 14px;
    }
    .browser-bar {
      padding: 7px;
      gap: 4px;
    }
    .browser-bar .dots {
      gap: 3px;
      margin-right: 0;
    }
    .browser-bar .dots i {
      width: 7px;
      height: 7px;
    }
    .url {
      padding: 4px;
      font-size: 9px;
    }
    .workflow-note {
      line-height: 22px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    manual-workflow
      :is(
        .workflow-scene,
        .typing,
        .running,
        .stopped,
        .demo-submit,
        .connected,
        .loading
      ) {
      animation: none !important;
    }
    .stopped,
    .loading {
      display: none;
    }
    .step-icon,
    .step-icon b,
    .workflow-step strong {
      transition: none;
    }
  }
</style>
