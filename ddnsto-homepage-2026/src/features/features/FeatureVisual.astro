---
import { featureIcons } from './icons';
interface Props {
  type: string;
  title: string;
}
const { type, title } = Astro.props;
const lock =
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>';
const pointer =
  '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="black" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4.037 4.688a.495.495 0 0 1 .651-.651l16 6.5a.5.5 0 0 1-.063.947l-6.124 1.58a2 2 0 0 0-1.438 1.435l-1.579 6.126a.5.5 0 0 1-.947.063z"></path></svg>';
const trash =
  '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 11v6"></path><path d="M14 11v6"></path><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"></path><path d="M3 6h18"></path><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>';
const log = [
  '$ tail -f /var/log/access.log',
  '[03:12:09] GET /service/status 200',
  '[03:12:11] sync completed',
  '[03:12:14] warning: high load (0.82)',
  '[03:12:18] session alive 00:12:44',
  '[03:12:20] POST /api/v1/heartbeat',
  '[03:12:22] user connected: admin',
  '[03:12:25] GET /dashboard/main',
  '[03:12:28] session alive 00:12:54',
  '[03:12:30] POST /api/v1/heartbeat',
  '[03:12:32] sync completed',
  '[03:12:35] GET /service/status 200',
  '[03:12:38] user connected: guest',
  '[03:12:40] GET /files/list',
  '[03:12:42] warning: disk usage 85%',
  '[03:12:45] POST /api/v1/upload',
  '[03:12:48] file saved: backup.zip',
  '[03:12:50] GET /settings/network',
];
const fileIcons: Record<string, string> = {
  Document:
    '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 22a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8a2.4 2.4 0 0 1 1.704.706l3.588 3.588A2.4 2.4 0 0 1 20 8v12a2 2 0 0 1-2 2z"></path><path d="M14 2v5a1 1 0 0 0 1 1h5"></path><path d="M10 9H8"></path><path d="M16 13H8"></path><path d="M16 17H8"></path></svg>',
  Video:
    '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="18" height="18" x="3" y="3" rx="2"></rect><path d="M7 3v18"></path><path d="M3 7.5h4"></path><path d="M3 12h18"></path><path d="M3 16.5h4"></path><path d="M17 3v18"></path><path d="M17 7.5h4"></path><path d="M17 16.5h4"></path></svg>',
  Program:
    '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20v2"></path><path d="M12 2v2"></path><path d="M17 20v2"></path><path d="M17 2v2"></path><path d="M2 12h2"></path><path d="M2 17h2"></path><path d="M2 7h2"></path><path d="M20 12h2"></path><path d="M20 17h2"></path><path d="M20 7h2"></path><path d="M7 20v2"></path><path d="M7 2v2"></path><rect x="4" y="4" width="16" height="16" rx="2"></rect><rect x="8" y="8" width="8" height="8" rx="1"></rect></svg>',
  Image:
    '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"></rect><circle cx="9" cy="9" r="2"></circle><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"></path></svg>',
};
const files = [
  ['Photos', 'Folder', '-'],
  ['Project.doc', 'Document', '2.4 MB'],
  ['Holiday.mp4', 'Video', '1.2 GB'],
  ['Setup.exe', 'Program', '45 MB'],
  ['Design.png', 'Image', '3.1 MB'],
];
---

<div
  class:list={['feature-demo', type]}
  role="img"
  aria-label={`${title}界面示意，非真实连接`}
  data-nosnippet
>
  {
    type === 'domain' && (
      <div class="demo-window">
        <div class="demo-bar">
          <>
            <span class="dots">
              <>
                <i />
                <i />
                <i />
              </>
            </span>
            <div class="address">
              <>
                <span set:html={lock} />
                <span>https://myrouter.ddnsto.com</span>
              </>
            </div>
          </>
        </div>
        <div class="router-demo">
          <aside class="router-sidebar">
            <>
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
              >
                <path d="M2 12h4l3-10 5 20 3-10h5" />
              </svg>
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <path d="M2 9a15 15 0 0 1 20 0M5 13a10 10 0 0 1 14 0M9 17a5 5 0 0 1 6 0M12 20h.01" />
              </svg>
              <span set:html={featureIcons[0]} />
              <span set:html={featureIcons[2]} />
            </>
          </aside>
          <div class="router-panels">
            <>
              <div class="router-status">
                <>
                  <strong>
                    系统状态 <i />
                  </strong>
                  <div class="meters">
                    <>
                      <div>
                        <>
                          <small>处理器负载</small>
                          <div>
                            <b />
                          </div>
                        </>
                      </div>
                      <div>
                        <>
                          <small>内存使用</small>
                          <div>
                            <b />
                          </div>
                        </>
                      </div>
                    </>
                  </div>
                </>
              </div>
              <div class="device-box">
                <>
                  <small>设备地址</small>
                  <div>192.168.1.2</div>
                  <small class="connected">已连接</small>
                </>
              </div>
              <div class="device-box">
                <>
                  <small>无线网络</small>
                  <div>DDNSTO_5G</div>
                  <small class="clients">5 台设备</small>
                </>
              </div>
            </>
          </div>
        </div>
      </div>
    )
  }
  {
    type === 'desktop' && (
      <div class="demo-window">
        <div class="desktop-bar">
          <>
            <span class="dots">
              <>
                <i />
                <i />
                <i />
              </>
            </span>
            <span class="desktop-tab">
              <span set:html={featureIcons[1]} /> Remote Desktop <b>×</b>
            </span>
            <div class="desktop-address">
              <span set:html={lock} />
              <span>https://app.ddnsto.com/vnc</span>
            </div>
          </>
        </div>
        <div class="desktop-demo">
          <>
            <div class="desktop-icons">
              <>
                <div>
                  <>
                    <span set:html={featureIcons[1]} />
                    <small>My PC</small>
                  </>
                </div>
                <div>
                  <>
                    <span set:html={trash} />
                    <small>Recycle Bin</small>
                  </>
                </div>
              </>
            </div>
            <span class="demo-pointer desktop-pointer" set:html={pointer} />
            <div class="taskbar">
              <>
                <b>⊞</b>
                <span>10:24 AM</span>
              </>
            </div>
          </>
        </div>
      </div>
    )
  }
  {
    type === 'terminal' && (
      <div class="terminal-shell">
        <>
          <div class="terminal-heading">
            <i />
            ssh root@edge <span>✓ tunnel secured</span>
          </div>
          <div class="terminal-demo">
            <div class="terminal-log">
              {[0, 1].map(() => (
                <div>
                  {log.map((line) => (
                    <p
                      class:list={{
                        good: /sync|file saved/.test(line),
                        warning: line.includes('warning'),
                        info: /user connected|^\$/.test(line),
                      }}
                    >
                      {line}
                    </p>
                  ))}
                </div>
              ))}
            </div>
          </div>
        </>
      </div>
    )
  }
  {
    type === 'files' && (
      <div class="demo-window file-window">
        <>
          <div class="demo-bar file-bar">
            <>
              <span class="dots">
                <>
                  <i />
                  <i />
                  <i />
                </>
              </span>
              <strong>File Manager</strong>
            </>
          </div>
          <div class="files-demo">
            <div class="file-head">
              <>
                <span>Name</span>
                <span>Type</span>
                <span>Size</span>
              </>
            </div>
            {files.map(([name, kind, size]) => (
              <div class="file-row">
                <span>
                  <span
                    class:list={['file-icon', kind.toLowerCase()]}
                    set:html={
                      kind === 'Folder' ? featureIcons[3] : fileIcons[kind]
                    }
                  />
                  {name}
                </span>
                <span>{kind}</span>
                <span>{size}</span>
              </div>
            ))}
            <aside class="demo-menu">
              <>
                <div>Download</div>
                <div>Rename</div>
                <div>Delete</div>
              </>
            </aside>
            <span class="demo-pointer file-pointer" set:html={pointer} />
          </div>
          <div class="file-footer">
            5 items <span>Free space: 450 GB</span>
          </div>
        </>
      </div>
    )
  }
</div>
<style>
  .feature-demo {
    position: relative;
    isolation: isolate;
    --surface: #ffffff0d;
    --color-border: #ffffff1a;
    --color-text: #fff;
    --color-muted: #6b7280;
    --color-link: #00f0ff;
    border: 1px solid var(--color-border);
    border-radius: 12px;
    border-color: #ffffff0d;
    background: #0000004d;
    padding: 16px;
    overflow: hidden;
    color: var(--color-text);
    font-size: 16px;
    line-height: 24px;
    pointer-events: none;
  }
  .feature-demo::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      to bottom right,
      #ffffff0d,
      transparent,
      #00f0ff0d
    );
    opacity: 0.6;
  }
  .feature-demo :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }
  .demo-window {
    border: 1px solid var(--color-border);
    border-radius: 8px;
    overflow: hidden;
    background: #12121a;
  }
  .demo-bar {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    background: var(--surface);
  }
  .dots {
    display: flex;
    gap: 6px;
    flex-shrink: 0;
  }
  .dots i {
    display: block;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: oklab(0.637 0.214213 0.1014 / 0.7);
  }
  .dots i:nth-child(2) {
    background: oklab(0.795 0.0126846 0.183562 / 0.7);
  }
  .dots i:nth-child(3) {
    background: oklab(0.723 -0.18885 0.110891 / 0.7);
  }
  .address {
    display: flex;
    align-items: center;
    flex: 1;
    gap: 8px;
    margin-left: 12px;
    padding: 4px 12px;
    border: 1px solid var(--color-border);
    border-radius: 4px;
    font-size: 10px;
    line-height: 15px;
    min-width: 0;
    white-space: nowrap;
  }
  .address > span:first-child,
  .desktop-address > span:first-child {
    width: 12px;
    height: 12px;
    color: #4ade80;
    flex-shrink: 0;
  }
  .router-demo {
    background: #1a1b26;
    display: flex;
    padding: 12px;
    gap: 12px;
  }
  .router-sidebar {
    width: 48px;
    flex-shrink: 0;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    background: var(--surface);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    padding: 12px 0;
    color: var(--color-muted);
  }
  .router-sidebar > svg,
  .router-sidebar > span {
    width: 20px;
    height: 20px;
  }
  .router-sidebar > svg:first-child {
    color: var(--color-link);
  }
  .router-panels {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    flex: 1;
    min-width: 0;
    align-content: start;
  }
  .router-status {
    grid-column: span 2;
    padding: 12px;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    background: var(--surface);
  }
  .router-status > strong {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 10px;
    line-height: 15px;
    margin-bottom: 8px;
  }
  .router-status i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #00c858;
  }
  .meters {
    display: flex;
    gap: 12px;
  }
  .meters > div {
    flex: 1;
    min-width: 0;
  }
  .meters small,
  .device-box small {
    display: block;
    font-size: 9px;
    line-height: 13.5px;
    color: var(--color-muted);
    margin-bottom: 4px;
  }
  .meters > div > div {
    height: 6px;
    border-radius: 9px;
    overflow: hidden;
  }
  .meters b {
    display: block;
    height: 100%;
    width: 60%;
    border-radius: 9px;
    background: var(--color-link);
    animation: feature-cpu 4s ease-in-out infinite;
    animation-play-state: var(--feature-play);
  }
  .meters > div:nth-child(2) b {
    background: #7000ff;
    animation-name: feature-memory;
    animation-duration: 5s;
  }
  .device-box {
    padding: 8px;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    background: var(--surface);
    font-size: 10px;
    line-height: 15px;
  }
  .device-box small:last-child {
    margin: 4px 0 0;
  }
  .device-box .connected {
    color: #4ade80;
  }
  .device-box .clients {
    color: var(--color-link);
  }
  .desktop-bar {
    --surface: #2d2d2d;
    position: relative;
    height: 74px;
    background: var(--surface);
    padding: 8px 12px;
    display: flex;
    align-items: flex-start;
    gap: 12px;
  }
  .desktop-tab {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 8px;
    padding: 4px 12px;
    background: #1e1e1e;
    border-radius: 8px 8px 0 0;
    font-size: 10px;
    line-height: 15px;
  }
  .desktop-tab > span {
    width: 14px;
    height: 14px;
    color: var(--color-link);
  }
  .desktop-tab b {
    color: var(--color-muted);
  }
  .desktop-address {
    position: absolute;
    bottom: 8px;
    left: 12px;
    right: 12px;
    display: flex;
    align-items: center;
    gap: 8px;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: #1e1e1e;
    padding: 4px 12px;
    font-size: 10px;
    line-height: 15px;
  }
  .desktop-demo {
    height: 166px;
    position: relative;
    background: #0078d7;
    overflow: hidden;
  }
  .desktop-icons {
    position: absolute;
    top: 16px;
    left: 16px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .desktop-icons > div {
    width: 48px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
  }
  .desktop-icons span {
    width: 32px;
    height: 32px;
    color: #fff;
  }
  .desktop-icons > div:first-child > span {
    width: 40px;
    height: 40px;
    padding: 4px;
    border-radius: 4px;
    animation: feature-desktop-highlight 3s ease-in-out infinite;
    animation-play-state: var(--feature-play);
  }
  @keyframes feature-desktop-highlight {
    0%,
    66.667%,
    100% {
      background: transparent;
    }
    13.333% {
      background: #ffffff1a;
    }
  }
  .desktop-icons small {
    font-size: 10px;
    line-height: 12.5px;
    text-align: center;
  }
  .taskbar {
    --surface: #101010;
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 8px;
    background: var(--surface);
    font-size: 8px;
    line-height: 12px;
  }
  .taskbar b {
    color: #55a0ff;
    font-size: 16px;
  }
  .demo-pointer {
    position: absolute;
    width: 16px;
    height: 16px;
    color: #fff;
    filter: drop-shadow(0 2px 2px #0002);
    z-index: 2;
  }
  .desktop-pointer {
    left: 112px;
    top: 112px;
    animation: feature-desktop 3.5s ease-in-out infinite;
    animation-play-state: var(--feature-play);
    transform: translate(-50%, -50%);
  }
  .terminal-shell {
    font-family:
      ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, 'Liberation Mono',
      'Courier New', monospace;
    height: 192px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 12px;
    line-height: 16px;
  }
  .terminal-heading {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--color-muted);
  }
  .terminal-heading i {
    width: 8px;
    height: 8px;
    background: #00f0ffcc;
    border-radius: 50%;
  }
  .terminal-heading span {
    color: #4ade80;
  }
  .terminal-demo {
    background: #0008;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    padding: 12px;
    flex: 1;
    overflow: hidden;
    position: relative;
  }
  .terminal-log {
    animation: feature-log 15s linear infinite;
    animation-play-state: var(--feature-play);
  }
  .terminal-log p {
    font: inherit;
    margin: 0;
    padding-bottom: 4px;
    white-space: nowrap;
  }
  .terminal-log .good {
    color: #4ade80;
  }
  .terminal-log .warning {
    color: #fde047;
  }
  .terminal-log .info {
    color: var(--color-link);
  }
  .file-window {
    height: 192px;
  }
  .file-bar {
    gap: 12px;
    font-size: 12px;
    line-height: 16px;
  }
  .file-bar strong {
    font-weight: 500;
    margin-left: 8px;
  }
  .files-demo {
    position: relative;
    padding: 8px;
  }
  .file-head,
  .file-row {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    align-items: center;
    padding: 6px 8px;
    font-size: 10px;
    line-height: 15px;
    margin-bottom: 4px;
  }
  .file-head {
    padding-block: 4px;
    margin-bottom: 8px;
    color: var(--color-muted);
  }
  .file-row {
    background: transparent;
    border-radius: 4px;
  }
  .file-row > span:first-child {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 11px;
    line-height: 16.5px;
  }
  .file-row > span:last-child,
  .file-head > span:last-child {
    text-align: right;
  }
  .file-row > span:not(:first-child) {
    color: var(--color-muted);
  }
  .file-icon {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
    color: var(--color-link);
  }
  .file-icon.document {
    color: #60a5fa;
  }
  .file-icon.program {
    color: #9ca3af;
  }
  .file-icon.image {
    color: #c084fc;
  }
  .file-icon.folder {
    color: #facc15;
  }
  .file-icon.video {
    color: #f87171;
  }
  .file-footer {
    display: flex;
    justify-content: space-between;
    font-size: 10px;
    padding: 4px 12px;
    background: var(--surface);
  }
  .demo-menu {
    color: #374151;
    position: absolute;
    left: 50px;
    top: 72px;
    width: 112px;
    padding: 4px 0;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    background: white;
    box-shadow: 0 12px 20px #0002;
    z-index: 1;
    animation: feature-menu 4s ease-in-out infinite;
    animation-play-state: var(--feature-play);
  }
  .demo-menu > div {
    padding: 6px 16px;
    font-size: 11px;
    line-height: 16.5px;
  }
  .file-pointer {
    left: 120px;
    top: 60px;
    animation: feature-file 4s ease-in-out infinite;
    animation-play-state: var(--feature-play);
  }
  @keyframes feature-cpu {
    0%,
    100% {
      width: 50%;
    }
    20% {
      width: 65%;
    }
    40% {
      width: 55%;
    }
    60% {
      width: 70%;
    }
    80% {
      width: 60%;
    }
  }
  @keyframes feature-memory {
    0%,
    100% {
      width: 60%;
    }
    20% {
      width: 55%;
    }
    40% {
      width: 68%;
    }
    60% {
      width: 52%;
    }
    80% {
      width: 65%;
    }
  }
  @keyframes feature-desktop {
    0%,
